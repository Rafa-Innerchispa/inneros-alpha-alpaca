# Server-side secret file: ~/.config/inneros-alpha/runtime.env
# Never commit the real file. The API/UI may run on Intel .4 while Qwen remains on AMD .5.
ALPACA_PAPER=true
ALPACA_PAPER_TRADE=true
ALPACA_API_BASE=https://paper-api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets
ALPACA_TOOLSETS=account,assets,stock-data,options-data,news

# Canonical credential names shared by the app and official Alpaca MCP.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Backward-compatible app alias only; prefer ALPACA_API_KEY above.
ALPACA_KEY_ID=

# Hackathon account metadata. Email is identity metadata, not a trading secret.
ALPACA_COMPETITION_ACCOUNT_DEDICATED=true
ALPACA_COMPETITION_ACCOUNT_EMAIL=test@soindu.com
ALPACA_COMPETITION_INITIAL_BALANCE_VERIFIED=false
ALPACA_PAPER_E2E_VERIFIED=false
INNEROS_ALPHA_WRITEUP_FINALIZED=true

# Preferred Intel .4 topology. For AMD-direct hosting use 127.0.0.1:8000/v1.
INNEROS_REASONING_URL=http://127.0.0.1:18000/v1
INNEROS_REASONING_MODEL=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ
INNEROS_REASONING_TIMEOUT=25

# Safe default. PAPER orders remain impossible until this is explicitly disarmed.
INNEROS_KILL_SWITCH_DEFAULT=true

# Optional evidence persistence.
INNEROS_MONGO_URI=
INNEROS_MONGO_DB=inneros_alpha_alpaca
INNEROS_MONGO_COLLECTION=pipeline_runs

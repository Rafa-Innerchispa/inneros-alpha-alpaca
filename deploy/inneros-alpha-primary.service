[Unit]
Description=InnerOS Alpha Alpaca PAPER control plane (primary host with private local reasoning)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/inneros-alpha-alpaca
Environment=ALPACA_PAPER=true
Environment=ALPACA_PAPER_TRADE=true
Environment=ALPACA_API_BASE=https://paper-api.alpaca.markets
Environment=ALPACA_DATA_BASE=https://data.alpaca.markets
Environment=ALPACA_TOOLSETS=account,assets,stock-data,options-data,news
Environment=ALPACA_COMPETITION_ACCOUNT_DEDICATED=true
Environment=INNEROS_REASONING_URL=http://127.0.0.1:8000/v1
Environment=INNEROS_REASONING_MODEL=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ
Environment=INNEROS_KILL_SWITCH_DEFAULT=true
EnvironmentFile=-%h/.config/inneros-alpha/runtime.env
ExecStart=%h/projects/inneros-alpha-alpaca/.venv/bin/python -m uvicorn src.main:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target

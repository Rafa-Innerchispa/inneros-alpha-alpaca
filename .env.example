# InnerOS Alpha — PAPER ONLY. Never commit secrets.
# Canonical credentials are shared by the Trading API adapter and official Alpaca MCP.
ALPACA_PAPER=true
ALPACA_PAPER_TRADE=true
ALPACA_API_BASE=https://paper-api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_TOOLSETS=account,assets,stock-data,options-data,news

# Competition-account evidence. These are runtime assertions, not decorative flags.
# Keep the email server-side; public readiness exposes presence only.
ALPACA_COMPETITION_ACCOUNT_EMAIL=
ALPACA_COMPETITION_ACCOUNT_DEDICATED=false
ALPACA_COMPETITION_INITIAL_BALANCE_VERIFIED=false
ALPACA_PAPER_E2E_VERIFIED=false

# Local-first reasoning through a private OpenAI-compatible endpoint.
INNEROS_REASONING_URL=http://127.0.0.1:8000/v1
INNEROS_REASONING_MODEL=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ
INNEROS_REASONING_TIMEOUT=25

INNEROS_KILL_SWITCH_DEFAULT=true
INNEROS_CONSOLE_ORIGINS=http://127.0.0.1:8099,http://localhost:8099

# Submission completion evidence. Do not mark true until proof exists.
INNEROS_ALPHA_WRITEUP_FINALIZED=false
INNEROS_ALPHA_DEMO_VIDEO_URL=

# Optional durable evidence. Empty URI keeps a safe in-memory evidence store.
INNEROS_MONGO_URI=
INNEROS_MONGO_DB=inneros_alpha_alpaca
INNEROS_MONGO_COLLECTION=pipeline_runs
